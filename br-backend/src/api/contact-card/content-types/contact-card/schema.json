{
  "kind": "collectionType",
  "collectionName": "contact_cards",
  "info": {
    "singularName": "contact-card",
    "pluralName": "contact-cards",
    "displayName": "Контакты / Карточки",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "cityName": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "department": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::contact-department.contact-department",
      "inversedBy": "contact_cards"
    },
    "contacts": {
      "type": "component",
      "repeatable": true,
      "component": "contacts.contact-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
